# copy this to .env, never commit real values
# all of these are required. in dev mode (-Dio.ktor.development=true) the three DB_ values have defaults

# key db. the service doesn't create the server_keys table itself, see the README
DB_URL=jdbc:postgresql://localhost:5433/keys
DB_USER=
DB_PASSWORD=

# token the auth service sends in X-Service-Token, has to match SERVICE_TOKEN_AUTH over there
AUTH_SERVICE_TOKEN=
# token the vault service sends
VAULT_SERVICE_TOKEN=
# token crypto 1 sends, only gets K_aes
AES_SERVICE_TOKEN=
# token crypto 2 sends, only gets K_chacha
CHACHA_SERVICE_TOKEN=

# peppers for login and vault. exactly 32 bytes of text, e.g. from openssl rand -hex 16
# the name says TEST, but the server reads the same variables
# changing one breaks every verifier that was built with the old value
TEST_PEPPER_LOGIN=
TEST_PEPPER_VAULT=

# master key that wraps all server keys. exactly 32 bytes of text, e.g. from openssl rand -hex 16
# changing it makes every stored key unreadable
MSK=
